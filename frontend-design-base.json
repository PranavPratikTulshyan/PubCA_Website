{
  "meta": {
    "brand_name": "Pranav PT",
    "tagline": "Bringing Technology Closer to Humans!",
    "brand_version": "1.0.0",
    "design_system_type": "JSON Driven Modular UI System",
    "framework_target": [
      "Astro",
      "React",
      "NextJS",
      "Vue",
      "TailwindCSS"
    ],
    "design_philosophy": {
      "primary_goal": "Make technology emotionally understandable for humans.",
      "user_feeling": [
        "Technology is understandable",
        "I can learn this",
        "This feels human",
        "This feels exploratory"
      ],
      "avoid_feelings": [
        "Intimidation",
        "Complexity overload",
        "Corporate coldness",
        "Developer elitism"
      ]
    }
  },

  "brand_personality": {
    "archetype": [
      "Teacher",
      "Explorer"
    ],
    "tone_of_voice": {
      "primary": [
        "Warm",
        "Curious",
        "Simplified",
        "Intelligent",
        "Friendly",
        "Mentor-like"
      ],
      "avoid": [
        "Arrogant",
        "Overly corporate",
        "Cyberpunk",
        "Aggressive startup tone",
        "Jargon-heavy"
      ]
    },
    "emotional_positioning": {
      "core_emotion": "Curiosity without fear",
      "trust_signal": "Technology explained simply",
      "experience_keywords": [
        "Human",
        "Interactive",
        "Understandable",
        "Modular",
        "Educational",
        "Exploratory"
      ]
    }
  },

  "design_tokens": {
    "colors": {
      "primary": {
        "50": "#F4F8FB",
        "100": "#DDEAF5",
        "200": "#BCD8EC",
        "300": "#8EBFE0",
        "400": "#5A9FD1",
        "500": "#2F7EBF",
        "600": "#2569A2",
        "700": "#1E5482",
        "800": "#183F61",
        "900": "#122D45"
      },

      "secondary": {
        "50": "#FFF7ED",
        "100": "#FFE9CC",
        "200": "#FFD199",
        "300": "#FFB366",
        "400": "#FF9433",
        "500": "#F97316",
        "600": "#D95F0E",
        "700": "#B74B08",
        "800": "#933705",
        "900": "#6F2803"
      },

      "neutral": {
        "white": "#FFFFFF",
        "background": "#F9FBFC",
        "surface": "#FFFFFF",
        "muted_surface": "#F3F5F7",
        "border": "#DCE3EA",
        "text_primary": "#1A1A1A",
        "text_secondary": "#4B5563",
        "text_muted": "#6B7280"
      },

      "semantic": {
        "success": "#16A34A",
        "warning": "#EAB308",
        "danger": "#DC2626",
        "info": "#0EA5E9"
      }
    },

    "gradients": {
      "hero_gradient": "linear-gradient(135deg, #F4F8FB 0%, #DDEAF5 100%)",
      "button_gradient": "linear-gradient(135deg, #2F7EBF 0%, #2569A2 100%)",
      "section_gradient": "linear-gradient(180deg, #FFFFFF 0%, #F9FBFC 100%)"
    },

    "typography": {
      "font_family": {
        "heading": "'Manrope', sans-serif",
        "body": "'Inter', sans-serif",
        "code": "'JetBrains Mono', monospace"
      },

      "font_weights": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },

      "font_sizes": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem",
        "6xl": "3.75rem"
      },

      "line_heights": {
        "tight": 1.1,
        "normal": 1.5,
        "relaxed": 1.8
      },

      "letter_spacing": {
        "tight": "-0.02em",
        "normal": "0",
        "wide": "0.02em"
      }
    },

    "spacing": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    },

    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px",
      "full": "9999px"
    },

    "shadows": {
      "sm": "0 1px 2px rgba(0,0,0,0.05)",
      "md": "0 4px 10px rgba(0,0,0,0.08)",
      "lg": "0 10px 25px rgba(0,0,0,0.10)",
      "xl": "0 20px 40px rgba(0,0,0,0.12)"
    },

    "transitions": {
      "fast": "150ms ease",
      "normal": "300ms ease",
      "slow": "500ms ease"
    }
  },

  "layout_system": {
    "container": {
      "max_width": "1280px",
      "padding_desktop": "32px",
      "padding_tablet": "24px",
      "padding_mobile": "16px"
    },

    "grid": {
      "desktop_columns": 12,
      "tablet_columns": 8,
      "mobile_columns": 4,
      "gutter": "24px"
    },

    "breakpoints": {
      "mobile": "480px",
      "tablet": "768px",
      "laptop": "1024px",
      "desktop": "1280px",
      "wide": "1440px"
    }
  },

  "hero_section": {
    "enabled": true,

    "content": {
      "badge": "Technology Made Human",

      "headline": {
        "line_1": "Technology was never difficult.",
        "line_2": "It was just badly explained."
      },

      "subheadline": "Understand AI, Apps & Automation in the simplest way possible — through real-world analogies and human-first explanations.",

      "primary_cta": {
        "text": "Explore Technology",
        "link": "/explore"
      },

      "secondary_cta": {
        "text": "Start Learning",
        "link": "/learn"
      }
    },

    "design": {
      "background_type": "gradient",
      "background_gradient": "hero_gradient",

      "alignment": "left",

      "headline_max_width": "720px",

      "headline_font_size": {
        "desktop": "5xl",
        "tablet": "4xl",
        "mobile": "3xl"
      },

      "headline_weight": "extrabold",

      "subheadline_font_size": {
        "desktop": "xl",
        "mobile": "base"
      },

      "section_padding": {
        "desktop": "128px 0",
        "tablet": "96px 0",
        "mobile": "72px 0"
      }
    }
  },

  "buttons": {
    "primary": {
      "background": "#2F7EBF",
      "text_color": "#FFFFFF",
      "border_radius": "16px",
      "padding": "14px 28px",
      "font_weight": 600,
      "hover_background": "#2569A2",
      "shadow": "md",
      "transition": "normal"
    },

    "secondary": {
      "background": "#FFFFFF",
      "text_color": "#2F7EBF",
      "border": "1px solid #DCE3EA",
      "border_radius": "16px",
      "padding": "14px 28px",
      "font_weight": 600,
      "hover_background": "#F4F8FB",
      "transition": "normal"
    },

    "ghost": {
      "background": "transparent",
      "text_color": "#1A1A1A",
      "hover_background": "#F3F5F7"
    }
  },

  "cards": {
    "default": {
      "background": "#FFFFFF",
      "border_radius": "24px",
      "padding": "32px",
      "border": "1px solid #DCE3EA",
      "shadow": "md",
      "hover_shadow": "lg",
      "transition": "normal"
    },

    "interactive": {
      "hover_translate_y": "-4px",
      "hover_scale": 1.01
    }
  },

  "navbar": {
    "height": "80px",
    "background": "rgba(255,255,255,0.85)",
    "blur": "12px",
    "sticky": true,

    "logo": {
      "text": "Pranav PT",
      "font_size": "xl",
      "font_weight": "bold"
    },

    "menu_items": [
      {
        "label": "Home",
        "href": "/"
      },
      {
        "label": "Explore Technology",
        "href": "/explore"
      },
      {
        "label": "AI Simplified",
        "href": "/ai"
      },
      {
        "label": "Build Apps",
        "href": "/apps"
      },
      {
        "label": "Automation",
        "href": "/automation"
      },
      {
        "label": "Resources",
        "href": "/resources"
      },
      {
        "label": "About",
        "href": "/about"
      }
    ]
  },

  "sections": {
    "exploration_section": {
      "title": "Explore How Technology Works",
      "subtitle": "Understand the engine behind modern technology.",

      "layout": "grid",

      "cards": [
        {
          "title": "AI",
          "description": "Understand what actually happens behind AI tools.",
          "icon": "brain"
        },
        {
          "title": "Apps",
          "description": "Learn how apps are structured internally.",
          "icon": "smartphone"
        },
        {
          "title": "Automation",
          "description": "See how systems automate repetitive work.",
          "icon": "workflow"
        },
        {
          "title": "Servers",
          "description": "Explore where your applications actually run.",
          "icon": "server"
        }
      ]
    }
  },

  "animation_system": {
    "global_animation_style": "smooth_and_subtle",

    "hover_animations": {
      "enabled": true,
      "duration": "300ms",
      "scale": 1.02
    },

    "scroll_animations": {
      "enabled": true,
      "style": "fade_up",
      "duration": "500ms"
    },

    "avoid": [
      "heavy parallax",
      "spinning objects",
      "gaming effects",
      "excessive motion blur"
    ]
  },

  "illustration_system": {
    "style": "simplified_technical_diagrams",

    "preferred_visuals": [
      "layered systems",
      "exploded diagrams",
      "modular blocks",
      "flow visualizations",
      "car analogies",
      "interactive concept visuals"
    ],

    "avoid_visuals": [
      "hackers",
      "robots",
      "dark cyberpunk",
      "generic stock coders",
      "neon AI graphics"
    ]
  },

  "microcopy": {
    "cta_examples": [
      "Explore Technology",
      "Understand AI",
      "Start Learning",
      "Decode Systems",
      "Build Your First App",
      "See How It Works"
    ],

    "input_placeholders": {
      "search": "Search technology concepts...",
      "email": "Enter your email",
      "query": "What would you like to understand?"
    }
  },

  "accessibility": {
    "minimum_contrast_ratio": "4.5:1",
    "focus_ring_color": "#2F7EBF",
    "focus_ring_width": "2px",
    "minimum_touch_target": "44px",
    "font_scaling_supported": true
  },

  "performance_rules": {
    "max_homepage_size_mb": 2,
    "preferred_image_format": "webp",
    "lazy_loading": true,
    "critical_font_preload": true,
    "mobile_first": true
  },

  "seo": {
    "default_title": "Pranav PT - Bringing Technology Closer to Humans",
    "default_description": "Understand AI, App Development, Automation & Technology in the simplest way possible.",
    "keywords": [
      "AI Simplified",
      "Learn Technology",
      "Automation",
      "App Development",
      "Human Friendly Technology",
      "Technology Education"
    ]
  },

  "developer_notes": {
    "architecture_goal": "Entire UI should be controllable via JSON driven config system.",

    "recommended_structure": {
      "tokens": "/config/design-tokens.json",
      "content": "/config/content.json",
      "navigation": "/config/navigation.json",
      "sections": "/config/sections.json",
      "theme": "/config/theme.json"
    },

    "important_rules": [
      "Never hardcode colors inside components",
      "Never hardcode spacing values",
      "Use token-based design everywhere",
      "Use reusable section renderer",
      "All content should be CMS/JSON driven",
      "Keep typography fully configurable"
    ]
  }
}